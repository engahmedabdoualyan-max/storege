# ---------------------------------------------------------------- server
# Copy this file to server/.env and adjust values for your environment.
# SQLite (default, zero configuration)
DATABASE_URL="file:./dev.db"

# PostgreSQL (after `npm run db:postgres`)
# DATABASE_URL="postgresql://storege:storege@localhost:5432/storege?schema=public"

PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# CHANGE THIS in production — long random string
JWT_SECRET="storege-dev-secret-change-me"
JWT_EXPIRES_IN="12h"

# Comma-separated list of allowed origins, or * for all
CORS_ORIGIN="http://localhost:5173"
APP_URL="http://localhost:4000"
COMPANY_TIMEZONE="Africa/Cairo"

# Set to true when the API sits behind a trusted reverse proxy
TRUST_PROXY=false
