// Storege WMS schema (SQLite by default, PostgreSQL variant available)
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- people
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("OPERATOR") // ADMIN | MANAGER | OPERATOR | VIEWER
  phone        String?
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ---------------------------------------------------------------- network
model Warehouse {
  id              String          @id @default(cuid())
  code            String          @unique
  name            String
  address         String?
  phone           String?
  manager         String?
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  zones           Zone[]
  locations       Location[]
  purchaseOrders  PurchaseOrder[]
  salesOrders     SalesOrder[]
  transfersOut    Transfer[]      @relation("TransferFrom")
  transfersIn     Transfer[]      @relation("TransferTo")
  cycleCounts     CycleCount[]
  receipts        Receipt[]
}

model Zone {
  id          String     @id @default(cuid())
  warehouseId String
  code        String
  name        String
  type        String     @default("STORAGE") // STORAGE | PICKING | RECEIVING | SHIPPING | QUARANTINE
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  locations   Location[]
  createdAt   DateTime   @default(now())

  @@unique([warehouseId, code])
}

model Location {
  id          String    @id @default(cuid())
  warehouseId String
  zoneId      String?
  code        String
  barcode     String    @unique
  name        String?
  rack        String?
  column      String?
  type        String    @default("PICK") // PICK | STAGING | DOCK | QUARANTINE | SHIPPING
  capacity    Float?
  active      Boolean   @default(true)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  zone        Zone?     @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  stocks      Stock[]
  receiptLines ReceiptLine[]
  allocations Allocation[]
  countLines  CycleCountLine[]
  movementsFrom StockMovement[] @relation("MovementFrom")
  movementsTo   StockMovement[] @relation("MovementTo")
  transferLinesFrom TransferLine[] @relation("TransferFrom")
  transferLinesTo   TransferLine[] @relation("TransferTo")
  createdAt   DateTime  @default(now())

  @@unique([warehouseId, code])
  @@index([warehouseId])
}

// ---------------------------------------------------------------- catalog
model Category {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  color     String   @default("#0ea5e9")
  items     Item[]
  createdAt DateTime @default(now())
}

model Item {
  id          String    @id @default(cuid())
  sku         String    @unique
  name        String
  description String?
  barcode     String?   @unique
  categoryId  String?
  unit        String    @default("قطعة")
  brand       String?
  cost        Float     @default(0)
  price       Float     @default(0)
  minStock    Float     @default(0)
  strategicStock Float  @default(0)
  maxStock    Float     @default(0)
  reorderQty  Float     @default(0)
  shelfLifeDays Int     @default(0)
  trackLot    Boolean   @default(false)
  trackSerial Boolean   @default(false)
  active      Boolean   @default(true)
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stocks      Stock[]
  lots        Lot[]
  serials     Serial[]
  poLines     PurchaseOrderLine[]
  receiptLines ReceiptLine[]
  soLines     SalesOrderLine[]
  allocations Allocation[]
  transferLines TransferLine[]
  countLines  CycleCountLine[]
  movements   StockMovement[]
  invoiceLines InvoiceLine[]

  @@index([categoryId])
  @@index([name])
}

model Lot {
  id         String    @id @default(cuid())
  itemId     String
  code       String
  expiryDate DateTime?
  createdAt  DateTime  @default(now())
  item       Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  stocks     Stock[]
  serials    Serial[]
  allocations Allocation[]
  transferLines TransferLine[]
  countLines CycleCountLine[]
  movements  StockMovement[]

  @@unique([itemId, code])
  @@index([expiryDate])
}

model Serial {
  id        String    @id @default(cuid())
  itemId    String
  lotId     String?
  serial    String
  status    String    @default("IN_STOCK") // IN_STOCK | RESERVED | SHIPPED | RETURNED
  createdAt DateTime  @default(now())
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  lot       Lot?      @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@unique([itemId, serial])
  @@index([status])
}

model Stock {
  id          String    @id @default(cuid())
  key         String    @unique
  itemId      String
  locationId  String
  lotId       String?
  serial      String?
  quantity    Float     @default(0)
  reserved    Float     @default(0)
  updatedAt   DateTime  @updatedAt
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  lot         Lot?      @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([locationId])
  @@index([lotId])
}

// ---------------------------------------------------------------- partners
model Supplier {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  taxNumber String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  purchaseOrders PurchaseOrder[]
}

model Customer {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  taxNumber String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  salesOrders SalesOrder[]
}

// ---------------------------------------------------------------- inbound
model PurchaseOrder {
  id          String              @id @default(cuid())
  number      String              @unique
  supplierId  String?
  warehouseId String
  status      String              @default("OPEN") // OPEN | PARTIAL | RECEIVED | CANCELLED
  expectedAt  DateTime?
  notes       String?
  subtotal    Float               @default(0)
  taxRate     Float               @default(0)
  taxAmount   Float               @default(0)
  total       Float               @default(0)
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  supplier    Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id])
  lines       PurchaseOrderLine[]
  receipts    Receipt[]

  @@index([status])
  @@index([warehouseId])
}

model PurchaseOrderLine {
  id           String            @id @default(cuid())
  poId         String
  itemId       String
  qty          Float
  receivedQty  Float             @default(0)
  unitCost     Float             @default(0)
  po           PurchaseOrder     @relation(fields: [poId], references: [id], onDelete: Cascade)
  item         Item              @relation(fields: [itemId], references: [id])
  receiptLines ReceiptLine[]

  @@index([poId])
  @@index([itemId])
}

model Receipt {
  id          String        @id @default(cuid())
  number      String        @unique
  poId        String?
  warehouseId String
  status      String        @default("POSTED") // POSTED | CANCELLED
  notes       String?
  createdById String?
  createdAt   DateTime      @default(now())
  po          PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  lines       ReceiptLine[]

  @@index([poId])
  @@index([createdAt])
}

model ReceiptLine {
  id         String            @id @default(cuid())
  receiptId  String
  poLineId   String?
  itemId     String
  locationId String?
  lotCode    String?
  expiryDate DateTime?
  serials    String?
  qty        Float
  receipt    Receipt           @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  poLine     PurchaseOrderLine? @relation(fields: [poLineId], references: [id], onDelete: SetNull)
  item       Item              @relation(fields: [itemId], references: [id])
  location   Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------- outbound
model SalesOrder {
  id          String          @id @default(cuid())
  number      String          @unique
  customerId  String?
  warehouseId String
  status      String          @default("OPEN") // OPEN | ALLOCATED | PICKING | PICKED | PACKED | SHIPPED | CANCELLED
  priority    String          @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  notes       String?
  shipTo      String?
  subtotal    Float           @default(0)
  taxRate     Float           @default(0)
  taxAmount   Float           @default(0)
  total       Float           @default(0)
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  shippedAt   DateTime?
  customer    Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  lines       SalesOrderLine[]
  allocations Allocation[]
  shipments   Shipment[]

  @@index([status])
  @@index([warehouseId])
}

model SalesOrderLine {
  id          String        @id @default(cuid())
  soId        String
  itemId      String
  qty         Float
  allocatedQty Float        @default(0)
  pickedQty   Float         @default(0)
  packedQty   Float         @default(0)
  unitPrice   Float         @default(0)
  so          SalesOrder    @relation(fields: [soId], references: [id], onDelete: Cascade)
  item        Item          @relation(fields: [itemId], references: [id])
  allocations Allocation[]

  @@index([soId])
  @@index([itemId])
}

model Allocation {
  id                String        @id @default(cuid())
  soId              String
  soLineId          String
  itemId            String
  locationId        String
  lotId             String?
  stockId           String?
  qty               Float
  pickedQty         Float         @default(0)
  stagingLocationId String?
  status            String        @default("RESERVED") // RESERVED | PICKED | CANCELLED
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  so                SalesOrder    @relation(fields: [soId], references: [id], onDelete: Cascade)
  soLine            SalesOrderLine @relation(fields: [soLineId], references: [id], onDelete: Cascade)
  item              Item          @relation(fields: [itemId], references: [id])
  location          Location      @relation(fields: [locationId], references: [id])
  lot               Lot?          @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@index([soId])
  @@index([itemId])
  @@index([status])
}

model Shipment {
  id          String     @id @default(cuid())
  soId        String
  carrier     String?
  tracking    String?
  notes       String?
  status      String     @default("SHIPPED")
  createdById String?
  shippedAt   DateTime   @default(now())
  so          SalesOrder @relation(fields: [soId], references: [id], onDelete: Cascade)

  @@index([soId])
}

// ---------------------------------------------------------------- transfers
model Transfer {
  id              String         @id @default(cuid())
  number          String         @unique
  fromWarehouseId String
  toWarehouseId   String
  status          String         @default("DRAFT") // DRAFT | IN_TRANSIT | RECEIVED | CANCELLED
  notes           String?
  createdById     String?
  createdAt       DateTime       @default(now())
  dispatchedAt    DateTime?
  receivedAt      DateTime?
  fromWarehouse   Warehouse      @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse      @relation("TransferTo", fields: [toWarehouseId], references: [id])
  lines           TransferLine[]

  @@index([status])
}

model TransferLine {
  id             String   @id @default(cuid())
  transferId     String
  itemId         String
  lotId          String?
  fromLocationId String?
  toLocationId   String?
  qty            Float
  transfer       Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item           Item     @relation(fields: [itemId], references: [id])
  lot            Lot?      @relation(fields: [lotId], references: [id], onDelete: SetNull)
  fromLocation   Location? @relation("TransferFrom", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation     Location? @relation("TransferTo", fields: [toLocationId], references: [id], onDelete: SetNull)

  @@index([transferId])
}

// ---------------------------------------------------------------- counting
model CycleCount {
  id          String           @id @default(cuid())
  number      String           @unique
  warehouseId String
  scope       String           @default("WAREHOUSE") // WAREHOUSE | LOCATION | ITEM
  locationId  String?
  itemId      String?
  status      String           @default("OPEN") // OPEN | COMPLETED | CANCELLED
  notes       String?
  createdById String?
  createdAt   DateTime         @default(now())
  completedAt DateTime?
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])
  lines       CycleCountLine[]

  @@index([status])
}

model CycleCountLine {
  id          String      @id @default(cuid())
  countId     String
  itemId      String
  locationId  String
  lotId       String?
  expectedQty Float
  countedQty  Float?
  variance    Float?
  count       CycleCount  @relation(fields: [countId], references: [id], onDelete: Cascade)
  item        Item        @relation(fields: [itemId], references: [id])
  location    Location    @relation(fields: [locationId], references: [id])
  lot         Lot?        @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@index([countId])
}

// ---------------------------------------------------------------- ledger
model StockMovement {
  id             String    @id @default(cuid())
  type           String // RECEIVE | PUTAWAY | PICK | PACK | SHIP | ADJUST | COUNT | TRANSFER_OUT | TRANSFER_IN | RETURN
  itemId         String
  fromLocationId String?
  toLocationId   String?
  lotId          String?
  serial         String?
  qty            Float
  refType        String?
  refId          String?
  userId         String?
  userName       String?
  note           String?
  createdAt      DateTime  @default(now())
  item           Item      @relation(fields: [itemId], references: [id])
  fromLocation   Location? @relation("MovementFrom", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation     Location? @relation("MovementTo", fields: [toLocationId], references: [id], onDelete: SetNull)
  lot            Lot?      @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([createdAt])
  @@index([type])
}

// ---------------------------------------------------------------- invoices
model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique
  type        String // SALES | PURCHASE
  partnerType String // CUSTOMER | SUPPLIER
  partnerId   String?
  partnerName String
  refType     String? // SALES_ORDER | PURCHASE_ORDER
  refId       String?
  date        DateTime      @default(now())
  dueDate     DateTime?
  subtotal    Float         @default(0)
  taxRate     Float         @default(0)
  taxAmount   Float         @default(0)
  total       Float         @default(0)
  paidAmount  Float         @default(0)
  status      String        @default("UNPAID") // UNPAID | PARTIAL | PAID | CANCELLED
  notes       String?
  createdById String?
  createdAt   DateTime      @default(now())
  lines       InvoiceLine[]

  @@index([status])
  @@index([type])
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  itemId      String?
  description String
  qty         Float
  unitPrice   Float
  total       Float
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item        Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

// ---------------------------------------------------------------- platform
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity])
  @@index([userId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Counter {
  name  String @id
  value Int    @default(0)
}

model ApiToken {
  id          String    @id @default(cuid())
  name        String
  prefix      String
  tokenHash   String    @unique
  scopes      String    @default("*")
  active      Boolean   @default(true)
  lastUsedAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
}

model WebhookEndpoint {
  id        String    @id @default(cuid())
  name      String
  url       String
  secret    String
  events    String    @default("*") // comma separated or *
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id            String          @id @default(cuid())
  endpointId    String
  event         String
  payload       String
  status        String          @default("PENDING") // PENDING | SUCCESS | FAILED
  attempts      Int             @default(0)
  responseCode  Int?
  error         String?
  nextAttemptAt DateTime?
  createdAt     DateTime        @default(now())
  deliveredAt   DateTime?
  endpoint      WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
}

model ProcessedOperation {
  id        String   @id
  endpoint  String
  userId    String?
  result    String
  createdAt DateTime @default(now())
}
